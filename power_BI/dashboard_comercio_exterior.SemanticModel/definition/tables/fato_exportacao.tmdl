				    #"Linhas Filtradas" = Table.SelectRows(#"Personalização Adicionada", each true),
				    #"Tipo Alterado2" = Table.TransformColumnTypes(#"Linhas Filtradas",{{"Data", type date}}),
				    #"Colunas Removidas" = Table.RemoveColumns(#"Tipo Alterado2",{"Mês"}),
				    #"Colunas Renomeadas1" = Table.RenameColumns(#"Colunas Removidas",{{"Mês.1", "Mês"}}),
				    #"Colunas Reordenadas" = Table.ReorderColumns(#"Colunas Renomeadas1",{"Data", "Ano", "Mês", "UF do Produto", "Países", "Código NCM", "Descrição NCM", "Valor US$ FOB", "Quilograma Líquido"}),
				    #"Personalização Adicionada1" = Table.AddColumn(#"Colunas Reordenadas", "Fluxo", each "Exportação"),
				    #"Tipo Alterado3" = Table.TransformColumnTypes(#"Personalização Adicionada1",{{"Fluxo", type text}}),
				    #"Texto Limpo" = Table.TransformColumns(#"Tipo Alterado3",{{"Países", Text.Clean, type text}, {"UF do Produto", Text.Clean, type text}, {"Descrição NCM", Text.Clean, type text}, {"Código NCM", Text.Clean, type text}}),
				  #"Personalização adicionada 1" = Table.TransformColumnTypes(Table.AddColumn(#"Texto Limpo", "UF para Mapa", each let
				    UF = Text.Upper(Text.Trim([UF do Produto]))
				in
				    if List.Contains(
				        {
				            "ACRE", "ALAGOAS", "AMAPÁ", "AMAZONAS",
				            "BAHIA", "CEARÁ", "DISTRITO FEDERAL",
				            "ESPÍRITO SANTO", "GOIÁS", "MARANHÃO",
