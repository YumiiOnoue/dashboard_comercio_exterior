	partition fato_exportacao = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents("C:\Users\yumi_\Documents\GitHub\dashboard_comercio_exterior\dados\exportacao_2010_2024.csv"), [Delimiter = ";", Columns = 8, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
