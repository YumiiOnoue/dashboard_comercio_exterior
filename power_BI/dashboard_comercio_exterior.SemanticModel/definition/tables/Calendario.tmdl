	column Ano/Mês
		lineageTag: 16eb0422-84cb-4089-93d7-c8d81f7e7ad6
		summarizeBy: none
		isNameInferred
		sourceColumn: [Ano/Mês]

		annotation SummarizationSetBy = Automatic

	partition Calendario = calculated
		mode: import
		source =
				
				VAR DataInicial = DATE(2010, 1, 1)
				VAR DataFinal = DATE(2024, 12, 31)
				RETURN
				ADDCOLUMNS(
				    CALENDAR(DataInicial, DataFinal),
				    "Ano", YEAR([Date]),
				    "Nome do Mês", FORMAT([Date], "MMMM"),
				    "Mês Num", MONTH([Date]),
				    "Trimestre", "Trim " & QUARTER([Date]),
				    "Ano/Mês", FORMAT([Date], "YYYY/MM")
				)

	annotation PBI_Id = a6c0af94a1444940b63e673a8b9640ba

