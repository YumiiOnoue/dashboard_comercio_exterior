table Medidas
	lineageTag: 1f4d13c8-efc2-4354-a327-7b9494e2cd09

	measure 'Corrente do Comercio' = [Total Exportado US$]+[Total Importado US$]
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 9dc6f32c-24c0-482a-9582-d947cb1b39f3

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Saldo Comercial' = [Total Exportado US$]-[Total Importado US$]
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: aaa58745-3858-4b54-93fb-8af19a82878a

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Total Importado US$' = CALCULATE(SUM(fato_comercio[Valor US$ FOB]), fato_comercio[Fluxo]="Importação")
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 27630a56-5d4e-46cf-9db6-df398cd186db

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Total Exportado US$' = CALCULATE(SUM(fato_comercio[Valor US$ FOB]), fato_comercio[Fluxo]= "Exportação")
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 571836f1-5816-4bec-a2d9-b4ff629545eb

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Ticket Médio Logístico' = ```
			
			DIVIDE(
			    SUM(Fato_Comercio[US$ Frete]) + SUM(Fato_Comercio[US$ Seguro]), 
			    SUM(Fato_Comercio[Quilograma Líquido])
			)
			```
		lineageTag: 14154dee-7776-4bff-a68e-79ff29880b41

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Peso Frete' =
			
			DIVIDE(SUM(Fato_Comercio[US$ Frete]), SUM(Fato_Comercio[Valor US$ CIF]))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e89e694d-bf99-44c4-b1bb-1f3e8fbfba68

	measure 'Preço Médio KG' = DIVIDE(SUM(Fato_Comercio[Valor US$ FOB]), SUM(Fato_Comercio[Quilograma Líquido]))
		lineageTag: f32ead0e-5ed8-435e-a155-eddf299fd576

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Valor US$ Ano Anterior' = CALCULATE(SUM(Fato_Comercio[Valor US$ FOB]), SAMEPERIODLASTYEAR('Calendario'[Date]))
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 94257469-7bd1-4dd3-a0a4-f06b4e7e0565

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Crescimento YoY %' = ```
			
			VAR ValorAtual = 
			    SUM ( 'Fato_Comercio'[Valor US$ FOB] )
			
			RETURN
			    DIVIDE ( 
			        ValorAtual - [Valor US$ Ano Anterior], 
			        [Valor US$ Ano Anterior] 
			    )
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: b331fe4d-b0aa-4d6d-b668-7b203c35e87c

	partition Medidas = m
		mode: import
		source =
				let
				    Fonte = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"Coluna 1" = _t]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"Coluna 1", type text}}),
				    #"Colunas Removidas" = Table.RemoveColumns(#"Tipo Alterado",{"Coluna 1"})
				in
				    #"Colunas Removidas"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegação

