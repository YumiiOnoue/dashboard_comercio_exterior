		sourceColumn: [DiaSemanaAbrev]

		annotation SummarizationSetBy = Automatic

	partition dim_calendario = calculated
		mode: import
		source =
				
				VAR DataInicial = DATE(2010, 1, 1)
				VAR DataFinal = DATE(2024, 12, 31)
				
				RETURN
				ADDCOLUMNS(
				    CALENDAR(DataInicial, DataFinal),
				    "Ano", YEAR([Date]),
				    "MesNum", MONTH([Date]),
				    "NomeMes", FORMAT([Date], "mmmm"),
				    "MesAbrev", FORMAT([Date], "mmm"),
				    "AnoMesNum", YEAR([Date]) * 100 + MONTH([Date]),
				    "AnoMes", DATE(YEAR([Date]), MONTH([Date]), 1),
				    "Trimestre", "T" & FORMAT([Date], "q"),
				    "TrimestreAno", "T" & FORMAT([Date], "q") & "/" & YEAR([Date]),
				    "DiaSemanaNum", WEEKDAY([Date], 2), -- 1 = Segunda, 7 = Domingo
				    "DiaSemana", FORMAT([Date], "dddd"),
				    "DiaSemanaAbrev", FORMAT([Date], "ddd")
				)

	annotation PBI_Id = a6c0af94a1444940b63e673a8b9640ba

