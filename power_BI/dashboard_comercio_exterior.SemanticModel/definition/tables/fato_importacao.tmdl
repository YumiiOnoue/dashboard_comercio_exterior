				    #"Tipo Alterado2" = Table.TransformColumnTypes(#"Colunas Reordenadas",{{"Data", type date}}),
				    #"Personalização Adicionada1" = Table.AddColumn(#"Tipo Alterado2", "Fluxo", each "Importação"),
