				    #"Texto Limpo" = Table.TransformColumns(#"Tipo Alterado3",{{"UF do Produto", Text.Clean, type text}, {"Países", Text.Clean, type text}, {"Código NCM", Text.Clean, type text}, {"Descrição NCM", Text.Clean, type text}}),
				  #"Personalização adicionada 1" = Table.TransformColumnTypes(Table.AddColumn(#"Texto Limpo", "UF para Mapa", each let
				    UF = Text.Upper(Text.Trim([UF do Produto]))
				in
