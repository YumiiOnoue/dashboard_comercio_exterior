annotation PBI_ProTooling = ["DevMode"]

ref table dim_calendario
ref table Medidas
ref table fato_exportacao
ref table fato_importacao
ref table dim_paises
ref table dim_ncm
ref table dim_uf

ref cultureInfo pt-BR

